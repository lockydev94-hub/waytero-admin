# Backend API base URL (includes /api/v1)
VITE_API_URL=http://localhost:8000/api/v1

# development | production
VITE_APP_ENV=development

# Dev seed credentials (shown in login page UI only in development)
VITE_DEV_ADMIN_MOBILE=9000000001
VITE_DEV_ADMIN_PASSWORD=ChangeMe

# Dev seed email (shown in login page UI only in development)
VITE_DEV_ADMIN_EMAIL=admin@waytero.dev
